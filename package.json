{
  "name": "kafe-zinciri",
  "version": "1.0.0",
  "description": "Kafe Zinciri — iOS ve Android uygulaması (Capacitor)",
  "scripts": {
    "build": "./build-app.sh",
    "sync": "./build-app.sh && npx cap sync",
    "android": "./build-app.sh && npx cap sync android && npx cap open android",
    "ios": "./build-app.sh && npx cap sync ios && npx cap open ios",
    "web": "sh -c \"cd game && sh build.sh\""
  },
