    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^14.1.0"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
